# Run a Sonic OS database backup every day at 02:00.
# Install:
#   1. cp deploy/cron/sonic-os-backup.cron.example /etc/cron.d/sonic-os-backup
#   2. Edit paths and user below
#   3. Ensure DATABASE_URL and PostgreSQL client tools (pg_dump) are available
#
# Manual backup:
#   npm run db:backup
#
# Logs append to /var/log/sonic-os-backup.log (create or change as needed).

SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

0 2 * * * sonic cd /opt/sonic-os && ./scripts/run-backup.sh >> /var/log/sonic-os-backup.log 2>&1
