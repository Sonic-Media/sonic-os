APP_ENV=production
APP_MODE=production
NEXT_PUBLIC_APP_MODE=production
NODE_ENV=production
DATABASE_URL=postgresql://sonic:CHANGE_ME@postgres:5432/sonic_os?schema=public
SESSION_SECRET=CHANGE_ME-use-openssl-rand-base64-48-minimum-32-chars
NEXT_PUBLIC_USE_API=true
PORT=3000
HOSTNAME=0.0.0.0
RUN_MIGRATIONS=true
RUN_SEED=false

# Data protection (see docs/DATA_PROTECTION.md)
ENABLE_DAILY_BACKUP=true
BACKUP_DIR=/var/backups/sonic-os
BACKUP_COMPRESS=true
BACKUP_INTERVAL_MS=86400000
ALLOW_DESTRUCTIVE_OPS=false
ALLOW_PRODUCTION_SEED=false
