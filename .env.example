# =============================================================================
# Sonic OS — environment configuration
# =============================================================================
# Copy to `.env` for local development, or use the templates under deploy/env/
# for Docker Compose profiles (development, staging, production).
#
# Required variables depend on APP_ENV — see README.production.md and
# docs/DEPLOYMENT.md.
# =============================================================================

# Application environment: development | staging | production
APP_ENV=development

# Production mode flag (also enables daily backups and destructive-action guards)
# APP_MODE=production
# NEXT_PUBLIC_APP_MODE=production

# Allow destructive CLI/API operations in production (maintenance windows only)
# ALLOW_DESTRUCTIVE_OPS=false

# Allow database seed in production (initial setup only)
# ALLOW_PRODUCTION_SEED=false

# Enable automatic daily PostgreSQL backups (defaults on when APP_MODE=production)
# ENABLE_DAILY_BACKUP=true

# Node.js runtime mode (use "production" for staging and production builds)
NODE_ENV=development

# PostgreSQL connection string (required for staging and production)
# DATABASE_URL=postgresql://sonic:sonic@localhost:5432/sonic_os?schema=public
#
# Priority: exported shell / platform env > .env.local > .env
# For a remote DB (e.g. Neon), put the URL in .env.local or export DATABASE_URL
# before running Prisma CLI commands. Remote URLs should include ?sslmode=require.
# Example: postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require

# Session signing secret — minimum 32 characters (required for staging/production)
# Generate with: openssl rand -base64 48
# SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Client-side API mode (must be "true" when using PostgreSQL)
NEXT_PUBLIC_USE_API=true

# HTTP server bind settings (used by `next start` and Docker)
PORT=3000
HOSTNAME=0.0.0.0

# Docker entrypoint options
# RUN_MIGRATIONS=true
# RUN_SEED=false

# Database backups (see docs/BACKUP.md)
# BACKUP_DIR=./backups
# BACKUP_COMPRESS=true
# BACKUP_INTERVAL_MS=86400000
# PG_DUMP_PATH=pg_dump
# PSQL_PATH=psql
