{
  "name": "sonic-os",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && next dev --webpack",
    "build": "prisma generate && next build",
    "build:production": "tsx scripts/validate-env.ts && npm run build",
    "start": "next start",
    "start:production": "next start --port ${PORT:-3000} --hostname ${HOSTNAME:-0.0.0.0}",
    "start:prod": "sh scripts/start-production.sh",
    "lint": "eslint",
    "validate:env": "tsx scripts/validate-env.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:bootstrap": "tsx scripts/bootstrap-application.ts",
    "verify:reports": "tsx scripts/verify-reports-aggregation.ts",
    "verify:reports-module": "tsx scripts/verify-reports-module.ts",
    "verify:stock": "tsx scripts/verify-stock-module.ts",
    "verify:sales": "tsx scripts/verify-sales-module.ts",
    "verify:expenses": "tsx scripts/verify-expenses-module.ts",
    "verify:purchasing": "tsx scripts/verify-purchasing-module.ts",
    "verify:operations": "tsx scripts/verify-daily-operations-module.ts",
    "verify:historical-import": "tsx scripts/verify-historical-import.ts",
    "verify:users": "tsx scripts/verify-users-module.ts",
    "verify:staff": "tsx scripts/verify-staff-module.ts",
    "verify:roles": "tsx scripts/verify-roles-permissions-module.ts",
    "verify:branch-isolation": "tsx scripts/verify-branch-isolation.ts",
    "verify:backup-roundtrip": "tsx scripts/verify-backup-roundtrip.ts",
    "verify:branch-operations": "tsx scripts/verify-branch-operations-isolation.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:backup:schedule": "tsx scripts/scheduled-backup.ts",
    "db:restore": "tsx scripts/restore-database.ts",
    "db:production-reset": "tsx scripts/production-reset.ts",
    "db:production-init": "tsx scripts/production-initialization.ts",
    "db:safe-reset": "tsx scripts/safe-transactional-reset.ts",
    "db:postgres:start": "sh scripts/start-postgres.sh",
    "docker:build": "docker compose build app",
    "docker:up:dev": "docker compose --profile development up",
    "docker:up:staging": "SONIC_ENV_FILE=deploy/env/staging.env docker compose --profile staging up -d",
    "docker:up:prod": "SONIC_ENV_FILE=deploy/env/production.env docker compose --profile production up -d",
    "docker:down": "docker compose --profile development --profile staging --profile production down"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
