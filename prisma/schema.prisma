generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  modules     String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  staff       Staff[]

  @@index([name])
}

model Branch {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  code           String           @unique
  address        String?
  phone          String?
  manager        String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  users          User[]
  staff          Staff[]
  dailyOps       DailyOperation[]
  sales          Sale[]
  purchases      Purchase[]
  expenseRecords ExpenseRecord[]
  stockMovements StockMovement[]
  staffPayments  StaffPayment[]
  dayClosings    DayClosing[]
  products       Product[]

  @@index([active])
  @@index([name])
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  username     String          @unique
  displayName  String
  passwordHash String
  roleId       String          @db.Uuid
  role         Role            @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  branchId     String          @db.Uuid
  branch       Branch          @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  staffId      String?         @unique @db.Uuid
  staff        Staff?          @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  active       Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  preferences  UserPreference?
  auditLogs    AuthAuditLog[]

  @@index([roleId])
  @@index([branchId])
  @@index([active])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  locked    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model UserPreference {
  userId           String   @id @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  activeBranchCode String
  updatedAt        DateTime @updatedAt
}

model AuthAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  username   String
  branchCode String
  action     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([branchCode])
  @@index([branchCode, createdAt])
}

model Staff {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  username         String?           @unique
  branchId         String            @db.Uuid
  branch           Branch            @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  roleId           String            @db.Uuid
  role             Role              @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  loginEnabled     Boolean           @default(false)
  status           String            @default("active")
  active           Boolean           @default(true)
  deletedAt        DateTime?
  phone            String?
  email            String?
  dailyWage        Int?
  monthlySalary    Int?
  dateJoined       String            @default("")
  emergencyContact String?
  notes            String?
  user             User?
  staffPayments    StaffPayment[]
  sales            Sale[]
  purchases        Purchase[]
  expenseRecords   ExpenseRecord[]
  dailyOperations  DailyOperation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([branchId])
  @@index([roleId])
  @@index([status])
  @@index([active])
  @@index([name])
  @@index([deletedAt])
}

model AppSetting {
  id                 String   @id @default("default")
  businessName       String
  ownerName          String
  branchNames        Json
  defaultLunchAmount Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model ExpenseTemplate {
  id            String   @id
  name          String
  category      String
  defaultAmount Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

model DailyOperation {
  id                String                  @id @default(uuid()) @db.Uuid
  date              String
  time              String
  timestamp         BigInt
  branchId          String                  @db.Uuid
  branch            Branch                  @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  sales             Int                     @default(0)
  staffId           String?                 @db.Uuid
  staff             Staff?                  @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  staffName         String                  @default("")
  createdBy         Json?
  notes             String                  @default("")
  savingsAllocation Int?
  status            String                  @default("draft")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  expenses          DailyOperationExpense[]

  @@unique([branchId, date])
  @@index([branchId])
  @@index([date])
  @@index([staffId])
  @@index([status])
  @@index([timestamp])
  @@index([branchId, date, timestamp])
}

model DailyOperationExpense {
  id               String         @id @default(uuid()) @db.Uuid
  dailyOperationId String         @db.Uuid
  dailyOperation   DailyOperation @relation(fields: [dailyOperationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  name             String
  amount           Int            @default(0)

  @@index([dailyOperationId])
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([active])
  @@index([name])
}

model Product {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  categoryId        String              @db.Uuid
  category          ProductCategory     @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  branchId          String              @db.Uuid
  branch            Branch              @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  sku               String?
  buyingPrice       Int                 @default(0)
  sellingPrice      Int                 @default(0)
  currentStock      Int                 @default(0)
  minimumStockLevel Int                 @default(0)
  notes             String?
  status            String              @default("in-stock")
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  movements         StockMovement[]
  priceChanges      StockPriceChange[]
  saleLineItems     SaleLineItem[]
  purchaseLineItems PurchaseLineItem[]

  @@unique([branchId, sku])
  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([categoryId, status])
  @@index([branchId, status])
  @@index([deletedAt])
}

model StockMovement {
  id          String   @id @default(uuid()) @db.Uuid
  date        String
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  productName String
  movement    String
  quantity    Int
  reason      String
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  notes       String?
  deletedAt   DateTime?
  createdBy   Json?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([date])
  @@index([movement])
  @@index([date, createdAt])
  @@index([branchId, date])
  @@index([deletedAt])
}

model StockPriceChange {
  id                   String   @id @default(uuid()) @db.Uuid
  productId            String   @db.Uuid
  product              Product  @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  previousBuyingPrice  Int
  previousSellingPrice Int
  newBuyingPrice       Int
  newSellingPrice      Int
  createdAt            DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Sale {
  id            String         @id @default(uuid()) @db.Uuid
  invoiceNumber String         @unique
  date          String
  time          String
  customerId    String?        @db.Uuid
  customer      Customer?      @relation(fields: [customerId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  customerName  String?
  subtotal      Int            @default(0)
  discount      Int            @default(0)
  total         Int            @default(0)
  profit        Int            @default(0)
  paymentMethod String
  branchId      String         @db.Uuid
  branch        Branch         @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  staffId       String?        @db.Uuid
  staff         Staff?         @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  staffName     String?
  createdBy     Json?
  completedBy   Json?
  notes         String?
  status        String         @default("completed")
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  items         SaleLineItem[]

  @@index([branchId])
  @@index([customerId])
  @@index([staffId])
  @@index([date])
  @@index([status])
  @@index([createdAt])
  @@index([branchId, date])
  @@index([branchId, status, date])
  @@index([deletedAt])
}

model SaleLineItem {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  sale        Sale    @relation(fields: [saleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  productName String
  quantity    Int
  unitPrice   Int
  buyingPrice Int
  lineTotal   Int

  @@index([saleId])
  @@index([productId])
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Purchase {
  id            String             @id @default(uuid()) @db.Uuid
  invoiceNumber String             @unique
  date          String
  supplierId    String             @db.Uuid
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  supplierName  String
  totalCost     Int                @default(0)
  branchId      String             @db.Uuid
  branch        Branch             @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  staffId       String?            @db.Uuid
  staff         Staff?             @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  staffName     String?
  createdBy     Json?
  notes         String?
  createdAt     DateTime           @default(now())
  items         PurchaseLineItem[]

  @@index([branchId])
  @@index([supplierId])
  @@index([staffId])
  @@index([date])
  @@index([createdAt])
  @@index([branchId, date])
}

model PurchaseLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  purchaseId  String   @db.Uuid
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  productName String
  quantity    Int
  buyingPrice Int
  lineTotal   Int

  @@index([purchaseId])
  @@index([productId])
}

model ExpenseCategory {
  id        String          @id
  name      String          @unique
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  records   ExpenseRecord[]

  @@index([isDefault])
}

model ExpenseRecord {
  id               String          @id @default(uuid()) @db.Uuid
  date             String
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  categoryName     String
  description      String
  amount           Int
  paymentMethod    String
  branchId         String          @db.Uuid
  branch           Branch          @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  staffId          String?         @db.Uuid
  staff            Staff?          @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  staffName        String?
  staffRole        String?
  staffPaymentType String?
  staffPaymentId   String?         @unique @db.Uuid
  createdBy        Json?
  paidBy           Json?
  notes            String?
  deletedAt        DateTime?
  staffPayment     StaffPayment?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([branchId])
  @@index([categoryId])
  @@index([staffId])
  @@index([date])
  @@index([branchId, date])
  @@index([createdAt])
  @@index([branchId, date, createdAt])
  @@index([deletedAt])
}

model DayClosing {
  id                  String    @id @default(uuid()) @db.Uuid
  date                String
  branchId            String    @db.Uuid
  branch              Branch    @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  status              String    @default("open")
  metrics             Json
  staffPayouts        Json
  expectedCash        Int       @default(0)
  actualCashCounted   Int       @default(0)
  cashDifference      Int       @default(0)
  cashStatus          String    @default("balanced")
  reconciliationNotes String?
  summary             Json
  closedBy            String?
  closedByName        String?
  closedAt            DateTime?
  openedBy            String?
  openedByName        String?
  openedAt            DateTime?
  reopenedBy          String?
  reopenedByName      String?
  reopenedAt          DateTime?
  closingNotes        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([branchId, date])
  @@index([branchId])
  @@index([date])
  @@index([status])
}

model AuditLogEntry {
  id         String   @id @default(uuid()) @db.Uuid
  timestamp  DateTime @default(now())
  userId     String
  userName   String
  role       String
  branchCode String
  action     String
  module     String
  recordId   String?
  detail     String?
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  @@index([branchCode])
  @@index([module])
  @@index([action])
  @@index([timestamp])
  @@index([userId])
  @@index([branchCode, timestamp])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  title       String
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

model StaffPayment {
  id            String        @id @default(uuid()) @db.Uuid
  staffId       String        @db.Uuid
  staff         Staff         @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  staffName     String
  staffRole     String
  amount        Int
  paymentType   String
  paymentMethod String
  branchId      String        @db.Uuid
  branch        Branch        @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  date          String
  expenseId     String        @unique @db.Uuid
  expense       ExpenseRecord @relation(fields: [expenseId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  paidBy        Json?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([staffId])
  @@index([branchId])
  @@index([date])
  @@index([branchId, date])
  @@index([createdAt])
}

model BackupRecord {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now())
  trigger        String
  createdById    String?
  createdByName  String?
  manifestPath   String
  filePath       String
  fileSizeBytes  BigInt?
  compressed     Boolean  @default(true)
  status         String   @default("completed")
  error          String?
  storageType    String   @default("filesystem")
  payload        Bytes?
  manifestJson   Json?

  @@index([createdAt])
  @@index([status])
  @@index([trigger])
  @@index([storageType])
}
